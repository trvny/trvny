{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)"
    ],
    "deny": [
      "Bash(chmod 777:*)",
      "Bash(dd:*)",
      "Bash(rm -rf:*)",
      "Bash(git clean:*)",
      "Bash(git reset --hard:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./.dev.vars)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)"
    ]
  },
  "env": {
    "CLAUDE_CODE_EFFORT_LEVEL": "auto"
  },
  "showTurnDuration": false,
  "attribution": {
    "commit": "",
    "pr": ""
  }
}
