{
  "version": 1,
  "model": {
    "autonomy": "high",
    "operatingMode": "act_then_report",
    "stopConditions": [
      "missing_credentials_or_permissions",
      "repository_or_goal_cannot_be_resolved",
      "material_product_decision_required",
      "unrelated_destructive_change_required",
      "external_secret_or_approval_required"
    ],
    "preferredActions": [
      "getOperatorBootstrap",
      "getGremlinKnowledge",
      "searchDocs",
      "inspectPackage",
      "searchEngramMemory",
      "getCloudflareOverview",
      "getOperatorCapabilities",
      "runOperatorSmokeTest",
      "runOperatorAutopilot",
      "getAccountMaintenance",
      "runAccountMaintenanceAutofix",
      "getRepositoryContext",
      "prepareChange",
      "implementCodeChange",
      "investigateCode",
      "reviewCodeChange",
      "inspectPullRequest",
      "finalizePullRequest",
      "orchestrateRelease",
      "diagnoseWorkflowRun"
    ]
  },
  "runtime": {
    "repositories": {
      "include": ["trvny/*"],
      "exclude": [],
      "skipArchived": true
    },
    "maintenance": {
      "autofix": true,
      "maxRepositoriesPerRun": 8,
      "maxFixesPerRun": 12,
      "workflowRetries": 1,
      "cacheMaxBytes": 5368709120,
      "cacheStaleDays": 5,
      "repositoryOverrides": []
    },
    "merge": {
      "enabled": true,
      "method": "squash",
      "requireGreenCi": true,
      "requireNoActionableReviews": true,
      "requireExpectedHeadSha": true
    },
    "release": {
      "allowedBranches": ["main"],
      "requireExpectedTargetSha": true
    },
    "cloudflare": {
      "enabled": true,
      "mutations": {
        "workerRollback": true,
        "pagesRollback": true,
        "workerSubdomain": true,
        "routeUpdate": true,
        "dnsUpdate": true
      }
    }
  }
}
