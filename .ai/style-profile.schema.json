{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/llm-styles/style-profile.schema.json",
  "title": "LLM Style Profile",
  "description": "Portable response-style configuration for plain chat and agentic systems.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "locale",
    "style"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "0.1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "minLength": 1,
      "maxLength": 80
    },
    "locale": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$"
    },
    "style": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base"
      ],
      "properties": {
        "base": {
          "type": "string",
          "enum": [
            "default",
            "professional",
            "friendly",
            "honest",
            "whimsical",
            "concise",
            "cynical"
          ]
        },
        "intensity": {
          "$ref": "#/$defs/intensity"
        },
        "modifiers": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "honest": {
              "$ref": "#/$defs/intensity"
            },
            "warm": {
              "$ref": "#/$defs/intensity"
            },
            "enthusiastic": {
              "$ref": "#/$defs/intensity"
            },
            "concise": {
              "$ref": "#/$defs/intensity"
            },
            "technical": {
              "$ref": "#/$defs/intensity"
            },
            "educational": {
              "$ref": "#/$defs/intensity"
            },
            "critical": {
              "$ref": "#/$defs/intensity"
            },
            "headingsAndLists": {
              "$ref": "#/$defs/intensity"
            },
            "emoji": {
              "$ref": "#/$defs/intensity"
            },
            "quickReplies": {
              "$ref": "#/$defs/intensity"
            },
            "whimsical": {
              "$ref": "#/$defs/intensity"
            },
            "cynical": {
              "$ref": "#/$defs/intensity"
            }
          }
        }
      }
    },
    "adaptation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "followUserRegister": {
          "type": "boolean",
          "default": true
        },
        "preserveRequestedArtifactStyle": {
          "type": "boolean",
          "default": true
        },
        "reduceHumorInSeriousContexts": {
          "type": "boolean",
          "default": true
        },
        "plainChatIsDefault": {
          "type": "boolean",
          "default": true
        },
        "respectExplicitTurnInstructions": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "chat": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "answerFirst": {
          "type": "boolean",
          "default": true
        },
        "avoidRoutinePraise": {
          "type": "boolean",
          "default": true
        },
        "avoidRoutineFollowUpOffer": {
          "type": "boolean",
          "default": true
        },
        "askOnlyBlockingQuestions": {
          "type": "boolean",
          "default": true
        },
        "mirrorLanguage": {
          "type": "boolean",
          "default": true
        },
        "allowCasualProfanity": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "announceOnlyMaterialActions": {
          "type": "boolean",
          "default": true
        },
        "reportPartialFailures": {
          "type": "boolean",
          "default": true
        },
        "exposePrivateReasoning": {
          "type": "boolean",
          "const": false
        },
        "preferResultOverProcess": {
          "type": "boolean",
          "default": true
        },
        "toolUsePolicy": {
          "type": "string",
          "enum": [
            "runtime",
            "auto",
            "required",
            "forbidden"
          ],
          "default": "runtime"
        },
        "subagentPolicy": {
          "type": "string",
          "enum": [
            "runtime",
            "avoidByDefault",
            "allowWhenParallelizable",
            "required",
            "forbidden"
          ],
          "default": "allowWhenParallelizable"
        }
      }
    },
    "knowledge": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "distinguishRawFromSynthesis": {
          "type": "boolean",
          "default": true
        },
        "treatMemoryAsFallible": {
          "type": "boolean",
          "default": true
        },
        "surfaceSourceConflicts": {
          "type": "boolean",
          "default": true
        },
        "preferMaintainedSynthesisForOrientation": {
          "type": "boolean",
          "default": true
        },
        "requireTraceableClaims": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "defaultFormat": {
          "type": "string",
          "enum": [
            "prose",
            "compact",
            "structured",
            "markdown"
          ],
          "default": "prose"
        },
        "maxHeadingDepth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6,
          "default": 3
        },
        "preferShortParagraphs": {
          "type": "boolean",
          "default": true
        },
        "tables": {
          "type": "string",
          "enum": [
            "avoid",
            "whenUseful",
            "prefer"
          ],
          "default": "whenUseful"
        },
        "codeExamples": {
          "type": "string",
          "enum": [
            "minimal",
            "runnable",
            "explanatory"
          ],
          "default": "runnable"
        },
        "citations": {
          "type": "string",
          "enum": [
            "platformDefault",
            "whenAvailable",
            "requiredForExternalFacts"
          ],
          "default": "platformDefault"
        }
      }
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z0-9.-]+$"
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "intensity": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 3
    }
  }
}
