{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "replace-me",
  "main": "src/index.ts",
  "compatibility_date": "YYYY-MM-DD",
  "observability": {
    "enabled": true,
  },

  // Replace the compatibility date when creating the project.
  // Add bindings only when the project uses them.
  // Keep secret values out of this file. Store them with Wrangler secrets or
  // the Cloudflare dashboard, and document names only in `.dev.vars.example`.
  //
  // "kv_namespaces": [
  //   { "binding": "CACHE", "id": "replace-me" }
  // ],
  // "d1_databases": [
  //   {
  //     "binding": "DB",
  //     "database_name": "replace-me",
  //     "database_id": "replace-me"
  //   }
  // ],
  // "r2_buckets": [
  //   { "binding": "BUCKET", "bucket_name": "replace-me" }
  // ]
}
