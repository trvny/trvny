{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Bash",
      "WebFetch",
      "Bash(npm run build)",
      "Bash(git commit *)",
      "Bash(npm run *)",
      "Bash(ls*)",
      "Bash(git * main)",
      "Edit",
      "Edit(/src/**/*.ts)",
      "Read(*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./.dev.vars)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)"
    ]
  }
}
