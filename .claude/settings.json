{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Read(*)",
      "Glob",
      "Grep",
      "Bash",
      "WebFetch",
      "Bash(npm run *)",
      "Bash(git commit * main)",
      "Bash(git pull origin main)",
      "Bash(git push origin main)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Edit",
      "Edit(/src/**/*.ts)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./.dev.vars)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)"
    ]
  }
}
