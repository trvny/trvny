{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "codebench",
  "compatibility_date": "2026-07-14",
  "compatibility_flags": ["nodejs_compat"],
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application"
  },
  "cache": {
   "enabled": true,
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": true }
  }
}
