{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gremlin",
  "main": "src/entry.ts",
  "compatibility_date": "2026-08-03",
  "compatibility_flags": ["nodejs_als", "global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": false,
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  // GPTomek App JWTs signed by kanarek-companion; PEM stays there.
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "b1efdebfe21741e98eac9211d8d4fdaf"
    }
  ],
  "services": [
    {
      "binding": "GPTOMEK_SIGNER",
      "service": "kanarek-companion",
      "entrypoint": "GptomekSignerEntrypoint"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "GREMLIN_OAUTH_REFRESH",
        "class_name": "GremlinGithubRefreshCoordinator"
      },
      {
        "name": "OPERATOR_CHECKPOINTS",
        "class_name": "OperatorCheckpointStore",
        "script_name": "kanarek-companion"
      },
      {
        "name": "ANCHOR_MUTATION_REPLAYS",
        "class_name": "AnchorMutationReplayStore",
        "script_name": "kanarek-companion"
      }
    ]
  },
  "migrations": [
    {
      "tag": "oauth-refresh-v1",
      "new_sqlite_classes": ["GremlinGithubRefreshCoordinator"]
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.01,
      "persist": true
    }
  },
  "vars": {
    "GPTOMEK_APP_ID": "4524407",
    "GPTOMEK_INSTALLATION_ID": "152126523",
    "GREMLIN_ANCHOR_FOLDER_ID": "01a07f52-1e05-7eeb-b9fe-53f7d75b3164"
  }
}
