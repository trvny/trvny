{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kanarek-review",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-31",
  "workers_dev": false,
  "preview_urls": false,
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "KANAREK_REVIEW_COOLDOWNS",
        "class_name": "ReviewProviderCooldownStore",
        "script_name": "automation"
      }
    ]
  },
  "observability": {
    "enabled": true,
    "issues": {
      "enabled": true
    },
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.1,
      "persist": true
    }
  },
  "vars": {
    "KANAREK_REVIEW_ROUTER_TIMEOUT_MS": "30000",
    "KANAREK_REVIEW_WORK_TIMEOUT_MS": "300000",
    "KANAREK_REVIEW_FREE_PROBE_TIMEOUT_MS": "10000",
    "KANAREK_REVIEW_QUOTA_COOLDOWN_MS": "600000",
    "KANAREK_REVIEW_TRANSIENT_COOLDOWN_MS": "30000",
    "KANAREK_REVIEW_PROVIDER_ORDER": "aihubmix,orcarouter,openrouter,ollama,groq,vercel,huggingface-publicai",
    "KANAREK_REVIEW_QUIP_PROVIDER_ORDER": "aihubmix,groq,vercel,openrouter,orcarouter,ollama,huggingface-publicai,gemini-standard",
    "KANAREK_REVIEW_REVIEW_PROVIDER_ORDER": "openrouter,aihubmix,orcarouter,vercel,ollama,groq,huggingface-publicai,gemini-standard",
    "KANAREK_REVIEW_JUDGE_PROVIDER_ORDER": "aihubmix,openrouter,orcarouter,vercel,groq,ollama,huggingface-publicai,gemini-standard",
