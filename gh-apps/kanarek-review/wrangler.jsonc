    "KANAREK_REVIEW_DECISION_AIHUBMIX_MODELS": "decision-model-preview,mammoth-1-free,elephant-1-free",
    "KANAREK_REVIEW_DECISION_OPENROUTER_MODELS": "inception/mercury-decide:free,baseten/mammoth-1:free,baseten/elephant-1:free,respan/span-01-lite:free",
    "KANAREK_REVIEW_DECISION_QWENCLOUD_MODELS": "decision-model-preview",
    "KANAREK_REVIEW_DECISION_VERCEL_MODELS": "convaiinnovations/laya-free",
    "KANAREK_REVIEW_AIHUBMIX_MODELS": "coding-kimi-k3-free,coding-glm-5.3-free,qwen3.8-max-free,xiaomi-mimo-v2.6-pro-free,coding-minimax-m3-free,nemotron-3.5-super-vl-free,nemotron-3.5-lightning-free,qwen3.8-flash-free,xiaomi-mimo-v2.6-flash-free,gemma-4-31b-it-free,laguna-s-2.1-free,agents-a1-free,dots-3-note-preview-free,lfm-2.5-2.6b-free",
