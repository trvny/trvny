{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kanarek-review",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-03",
  "compatibility_flags": [
    "nodejs_als"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "KANAREK_REVIEW_COOLDOWNS",
        "class_name": "ReviewProviderCooldownStore",
        "script_name": "kanarek-companion"
      }
    ]
  },
  "ai": {
    "binding": "AI"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.1,
      "persist": true
    }
  },
  "vars": {
    "KANAREK_REVIEW_ROUTER_TIMEOUT_MS": "30000",
    "KANAREK_REVIEW_WORK_TIMEOUT_MS": "300000",
    "KANAREK_REVIEW_FREE_PROBE_TIMEOUT_MS": "10000",
    "KANAREK_REVIEW_QUOTA_COOLDOWN_MS": "600000",
    "KANAREK_REVIEW_TRANSIENT_COOLDOWN_MS": "30000",
    "KANAREK_REVIEW_PROVIDER_ORDER": "aihubmix,orcarouter,openrouter,ollama,groq,vercel,huggingface-publicai",
    "KANAREK_REVIEW_AIHUBMIX_MODELS": "xiaomi-mimo-v2.6-flash-free,coding-kimi-k3-free,dots-3-note-preview-free,nemotron-3.5-lightning-free,hy3-free,minimax-m2.7-free,ling-3.0-flash-free,lfm-2.5-2.6b-free",
    "KANAREK_REVIEW_ORCAROUTER_MODELS": "orcarouter/auto",
    "KANAREK_REVIEW_OPENROUTER_MODELS": "stealth/space-bunny-alpha,nvidia/nemotron-3.5-lightning:free,dots-studio/dots-3-note-preview:free,nvidia/nemotron-3-ultra-550b-a55b:free,cohere/north-mini-code:free,openrouter/free",
    "KANAREK_REVIEW_OLLAMA_MODELS": "gpt-oss:120b,gpt-oss:20b",
    "KANAREK_REVIEW_GROQ_MODEL": "openai/gpt-oss-120b",
    "KANAREK_REVIEW_GROQ_REASONING_EFFORT": "high",
    "KANAREK_REVIEW_VERCEL_MODELS": "tencent/hy3,alibaba/qwen3.8-omni-flash,alibaba/qwen3-coder-30b-a3b,inclusionai/ling-3.1-flash-free,poolside/laguna-s-2.1-free",
    "KANAREK_REVIEW_REASONING_MIN_MAX_TOKENS": "16384",
    "KANAREK_REVIEW_REASONING_EFFORT": "high",
    "KANAREK_REVIEW_VERCEL_HY3_TEMPERATURE": "0.9",
    "KANAREK_REVIEW_VERCEL_HY3_TOP_P": "1",
    "KANAREK_REVIEW_HUGGINGFACE_MODEL": "speakleash/Bielik-11B-v3.0-Instruct:publicai",
    "KANAREK_REVIEW_WORKERS_AI_ENABLED": "true",
    "KANAREK_REVIEW_WORKERS_AI_MODEL": "@cf/zai-org/glm-4.7-flash",
    "KANAREK_REVIEW_WORKERS_AI_MAX_OUTPUT_TOKENS": "16384",
    "KANAREK_REVIEW_WORKERS_AI_DAILY_NEURONS": "10000",
    "KANAREK_REVIEW_PAID_PROVIDER_ORDER": "deepseek,gemini-flex",
    "KANAREK_REVIEW_DEEPSEEK_MODEL": "deepseek-flash",
    "KANAREK_REVIEW_DEEPSEEK_THINKING": "enabled",
    "KANAREK_REVIEW_DEEPSEEK_REASONING_EFFORT": "max",
    "KANAREK_REVIEW_DEEPSEEK_MAX_TOKENS": "131072",
    "KANAREK_REVIEW_GEMINI_MODEL": "gemini-3.8-flash",
    "KANAREK_REVIEW_GEMINI_SERVICE_TIER": "flex"
  }
}
