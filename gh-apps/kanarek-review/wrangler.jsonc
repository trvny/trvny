    "KANAREK_REVIEW_ORCAROUTER_QUIP_MODELS": "z-ai/glm-5.3-flash-free,deepseek/deepseek-v4.1-flash-free,tencent/hy3-free,tencent/hy4-preview-free",
    "KANAREK_REVIEW_ORCAROUTER_REVIEW_MODELS": "deepseek/deepseek-v4.1-flash-free,z-ai/glm-5.3-flash-free,tencent/hy4-preview-free,tencent/hy3-free",
