{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shitpost-reactor",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-31",
  "workers_dev": true,
  "preview_urls": false,
  "issue_detection": {
      "enabled": true
    },
  "routes": [
    {
      "pattern": "shitpost.trfny.com",
      "custom_domain": true
    },
    {
      "pattern": "shitpost.bartek.lol",
      "custom_domain": true
    }
  ],
  "ratelimits": [{
    "name": "SUBMISSION_LIMIT",
    "namespace_id": "9361201",
    "simple": { "limit": 2, "period": 60 }
  }],
  "r2_buckets": [
    {
      "binding": "FEED",
      "bucket_name": "shitpost-reactor"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.01,
      "persist": true,
      "invocation_logs": false
    },
    "traces": {
      "enabled": false
    }
  }
}
