{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "pet-dispatcher-control",
  "main": "entry.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": false
  },
  "queues": {
    "producers": [
      { "binding": "TASK_QUEUE", "queue": "pet-dispatcher-tasks" }
    ]
  },
  "durable_objects": {
    "bindings": [
      { "name": "TASK_STATE", "class_name": "TaskStateStore" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["TaskStateStore"] }
  ],
  "vars": {
    "DEVICE_ID": "legion"
  }
}
