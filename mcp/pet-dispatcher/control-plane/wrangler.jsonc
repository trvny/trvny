{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "pet-dispatcher-control",
  "main": "entry.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": false,
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": false,
      // Connector compatibility can place MCP_CONNECTOR_TOKEN in /mcp/<token>.
      // Keep invocation logs off so that secret URL never lands in Worker logs.
      "invocation_logs": false
    },
    "traces": {
      "enabled": false
    }
  },
  "kv_namespaces": [
    { "binding": "OAUTH_KV", "id": "eb005239a6b04209b0a4f9bc79f71bcb" }
  ],
  "queues": {
    "producers": [
      { "binding": "TASK_QUEUE", "queue": "pet-dispatcher-tasks" }
    ]
  },
  "services": [
    { "binding": "KANAREK_COMPANION", "service": "kanarek-companion" }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "TASK_STATE", "class_name": "TaskStateStore" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["TaskStateStore"] }
  ],
  "vars": {
    "DEVICE_ID": "legion",
    "PET_OAUTH_GITHUB_ID": "120686325",
    "PET_OAUTH_GITHUB_LOGIN": "trvny"
  }
}
