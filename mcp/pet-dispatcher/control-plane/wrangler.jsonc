{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "pet-dispatcher-control",
  "main": "entry.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      // Connector compatibility can place MCP_CONNECTOR_TOKEN in /mcp/<token>.
      // Keep invocation logs off so that secret URL never lands in Worker logs.
      "invocation_logs": false
    },
    "traces": {
      "enabled": false
    }
  },
  "queues": {
    "producers": [
      { "binding": "TASK_QUEUE", "queue": "pet-dispatcher-tasks" }
    ]
  },
  "durable_objects": {
    "bindings": [
      { "name": "TASK_STATE", "class_name": "TaskStateStore" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["TaskStateStore"] }
  ],
  "vars": {
    "DEVICE_ID": "legion"
  }
}
