{
  "workspaceRoot": "C:\\pet-dispatcher-worker",
  "repositories": {
    "trvny": "C:\\path\\to\\trvny"
  },
  "workspaces": {
    "dc": "C:\\Users\\travn\\dir\\.dc"
  },
  "toolRoots": [],
  "resourceLimits": {
    "defaultMemoryMiB": 2048,
    "maxMemoryMiB": 6144,
    "defaultProcessCount": 32,
    "maxProcessCount": 64,
    "watchdogIntervalMs": 250
  },
  "sessionReaperIntervalMs": 15000,
  "networkProfiles": {
    "github-read": {
      "hosts": [
        "github.com",
        "api.github.com",
        "codeload.github.com",
        "raw.githubusercontent.com",
        "objects.githubusercontent.com",
        "release-assets.githubusercontent.com"
      ]
    },
    "npm-read": {
      "hosts": ["registry.npmjs.org"]
    },
    "github-npm-read": {
      "hosts": ["github.com", "api.github.com", "codeload.github.com", "raw.githubusercontent.com", "objects.githubusercontent.com", "release-assets.githubusercontent.com", "registry.npmjs.org"]
    },
    "android-read": {
      "hosts": ["dl.google.com", "maven.google.com", "repo1.maven.org", "services.gradle.org"]
    },
    "cloudflare-api": {
      "hosts": ["api.cloudflare.com"]
    }
  },
  "remote": {
    "enabled": false,
    "deviceId": "legion",
    "accountId": "00000000000000000000000000000000",
    "queueId": "00000000000000000000000000000000",
    "controlPlaneUrl": "https://pet-dispatcher-control.example.workers.dev",
    "queueTokenEnv": "PET_DISPATCHER_QUEUE_TOKEN",
    "signingSecretEnv": "PET_DISPATCHER_SIGNING_SECRET",
    "pollIntervalMs": 5000,
    "pollMaxIntervalMs": 60000,
    "heartbeatIntervalMs": 15000,
    "visibilityTimeoutMs": 1800000,
    "journalPath": "remote-journal.json"
  }
}
