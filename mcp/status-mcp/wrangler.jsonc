{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "status-mcp",
  "main": "src/entry.ts",
  "compatibility_date": "2026-07-14",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.01,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false
    }
  },
  // Same-account Workers reached via internal service bindings (a public
  // workers.dev fetch between same-account Workers hairpins and fails).
  "services": [
    { "binding": "TVPI", "service": "tvpi" },
    { "binding": "WEATHER", "service": "weather" },
    { "binding": "AUTKA", "service": "cargate-backend" }
  ]
}
