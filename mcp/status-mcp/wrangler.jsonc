{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "status-mcp",
  "main": "src/entry.ts",
  "compatibility_date": "2026-07-14",
  "compatibility_flags": ["nodejs_compat"],
  // A remote MCP connector can only reach a public URL, so workers.dev has to
  // be on for this to be usable as one at all. What keeps it from being an open
  // button that makes the bound Workers do work is the bearer check in
  // src/entry.ts, which fails closed when STATUS_MCP_TOKEN is unset.
  // Previews stay off: they would publish the same endpoint on per-version URLs.
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.01,
      "persist": true,
      // invocation_logs off deliberately: the token can arrive in the URL path
      // (see src/entry.ts), and an invocation log would record that URL.
      "invocation_logs": false
    },
    "traces": {
      "enabled": false
    }
  },
  // Same-account Workers reached via internal service bindings (a public
  // workers.dev fetch between same-account Workers hairpins and fails).
  "services": [
    { "binding": "TVPI", "service": "tvpi" },
    { "binding": "WEATHER", "service": "weather" },
    { "binding": "AUTKA", "service": "cargate-backend" }
  ]
}
