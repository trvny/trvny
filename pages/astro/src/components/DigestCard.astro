---
import DigestMedia from './DigestMedia.astro';
const { card } = Astro.props;
---
<article class="digest-card">
  {card.media && <DigestMedia media={card.media} />}
  <div class="card-copy">
    {card.kicker && <span class="kicker">{card.kicker}</span>}
    <h3>{card.title}</h3>
    {card.score && <div class="score">
      <span>{card.score.home}</span><strong>{card.score.result}</strong><span>{card.score.away}</span>
      {card.score.detail && <small>{card.score.detail}</small>}
    </div>}
    {card.quote && <blockquote>{card.quote.text}<footer>{card.quote.attribution}</footer></blockquote>}
    {card.price && <div class="offer-price"><strong>{card.price}</strong>{card.previousPrice && <del>{card.previousPrice}</del>}</div>}
    {card.deadline && <p class="deadline">{card.deadline}</p>}
    {card.facts?.length > 0 && <dl class="facts">{card.facts.map(({ label, value }) => <div><dt>{label}</dt><dd>{value}</dd></div>)}</dl>}
    {card.body && <p>{card.body}</p>}
    {card.gallery?.length > 0 && <div class="gallery">{card.gallery.map(media => <DigestMedia media={media}/>)}</div>}
    {card.links?.length > 0 && <div class="sources">{card.links.map(link => <a href={link.url}>{link.label} ↗</a>)}</div>}
  </div>
</article>
<style>
  .digest-card { display: flex; flex-direction: column; min-width: 0; overflow: hidden; border: 1px solid #273748; border-radius: 14px; background: var(--panel); }
  .card-copy { display: flex; flex-direction: column; flex: 1; padding: 18px; gap: 12px; }
  .digest-card h3 { margin: 0; font: 700 19px/1.35 system-ui,sans-serif; color: var(--text); overflow-wrap: anywhere; }
  .digest-card p { font: 15px/1.65 system-ui,sans-serif; margin: 0; white-space: pre-line; }
  .offer-price { display: flex; flex-wrap: wrap; align-items: baseline; gap: 10px; font-family: system-ui,sans-serif; }
  .offer-price strong { font-size: 27px; color: var(--yellow); }
  .offer-price del { color: var(--muted); font-size: 14px; }
  .digest-card .deadline { color: var(--yellow); font-size: 13px; }
  .facts { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 8px; margin: 0; }
  .facts div { min-width: 0; background: #121c28; border-radius: 6px; padding: 8px; }
  .facts dt { font: 12px/1.4 system-ui,sans-serif; color: var(--muted); overflow-wrap: anywhere; }
  .facts dd { font: 600 14px/1.4 system-ui,sans-serif; margin: 3px 0 0; overflow-wrap: anywhere; }
  .sources { display: flex; flex-wrap: wrap; gap: 10px 16px; margin-top: auto; }
  .sources a { font: 600 13px/1.45 system-ui,sans-serif; }
  .kicker { color: var(--cyan); font: 600 12px/1.5 system-ui,sans-serif; text-transform: uppercase; }
  .score { display: grid; grid-template-columns: 1fr auto 1fr; gap: 10px; text-align: center; align-items: center; padding: 14px 4px; background: #121c28; border-radius: 8px; font: 600 14px/1.4 system-ui,sans-serif; overflow-wrap: anywhere; }
  .score strong { color: var(--yellow); font-size: 28px; }
  .score small { grid-column: 1/-1; color: var(--muted); }
  blockquote { margin: 0; border-left: 3px solid var(--pink); padding: 8px 12px; font: 17px/1.6 system-ui,sans-serif; }
  blockquote footer { margin-top: 8px; font-size: 13px; color: var(--muted); }
  .gallery { display: grid; grid-template-columns: repeat(auto-fit,minmax(min(140px,100%),1fr)); gap: 10px; }
</style>
