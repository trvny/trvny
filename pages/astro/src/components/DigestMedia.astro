---
import DigestEmbed from './DigestEmbed.astro';
const { media, eager = false } = Astro.props;
---
<figure class:list={['digest-media', 'aspect-' + (media.aspect ?? 'wide')]}>
  {media.kind === 'embed' ? <DigestEmbed media={media}/> : media.kind === 'video' ? (
    <video controls playsinline preload="none" aria-label={media.alt}>
      <source src={media.src} />
      <a href={media.src}>{media.alt}</a>
    </video>
  ) : (
    <img src={media.src} alt={media.alt} loading={eager ? 'eager' : 'lazy'}
      decoding="async" referrerpolicy="no-referrer" />
  )}
  {media.transcript && <details class="transcript"><summary>Transkrypcja / opis</summary><p>{media.transcript}</p></details>}
  <figcaption>{media.alt} · {media.source ? <a href={media.source}>{media.credit}</a> : media.credit}</figcaption>
</figure>
<style>
  .digest-media { margin: 0; min-width: 0; }
  .digest-media img, .digest-media video { display: block; width: 100%; aspect-ratio: 16/9; max-height: 520px; object-fit: contain; background: #0a111b; border-radius: 10px; }
  .digest-media figcaption { color: var(--muted); font: 12px/1.5 system-ui,sans-serif; padding: 8px 2px; overflow-wrap: anywhere; }
  .aspect-square img, .aspect-square video { aspect-ratio: 1; }
  .aspect-portrait img, .aspect-portrait video { aspect-ratio: 3/4; }
  .transcript { padding: 8px; font: 13px/1.5 system-ui,sans-serif; }
  .transcript summary { cursor: pointer; color: var(--cyan); }
  .transcript p { white-space: pre-line; overflow-wrap: anywhere; }
</style>
