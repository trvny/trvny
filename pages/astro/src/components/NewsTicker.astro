<section class="panel news" data-hn-news>
  <h2>LIVE / Hacker News</h2>
  <p class="meta">Top stories · refresh every 5 min · data from the official HN API</p>
  <ul data-hn-list aria-live="polite"><li>Fetching headlines…</li></ul>
  <p class="hint" data-hn-updated></p>
  <a href="https://news.ycombinator.com/">Open Hacker News ↗</a>
</section>
<script>
  const root = document.querySelector('[data-hn-news]');
  if (root) {
    const list = root.querySelector('[data-hn-list]');
    const updated = root.querySelector('[data-hn-updated]');
    const api = 'https://hacker-news.firebaseio.com/v0/';
    let refreshing = false;
    async function fetchWithTimeout(url) {
      const controller = new AbortController();
      const timer = setTimeout(() => controller.abort(), 10000);
      try {
        return await fetch(url, { signal: controller.signal });
      } finally {
        clearTimeout(timer);
      }
    }
    async function refresh() {
      if (document.hidden || refreshing) return;
      refreshing = true;
      try {
        const res = await fetchWithTimeout(api + 'topstories.json');
        if (!res.ok) throw new Error('topstories unavailable');
        const ids = (await res.json()).slice(0, 6);
        const stories = await Promise.all(ids.map(async (id) => {
          try {
            const response = await fetchWithTimeout(api + 'item/' + id + '.json');
            return response.ok ? response.json() : null;
          } catch {
            return null;
          }
        }));
        const available = stories.filter((item) => item && item.title);
        if (!available.length) throw new Error('no stories available');
        list.replaceChildren();
        for (const story of available) {
          const li = document.createElement('li');
          const a = document.createElement('a');
          a.textContent = story.title;
          let destination;
          try { destination = new URL(story.url); } catch { /* Use the discussion URL. */ }
          a.href = destination && ['http:', 'https:'].includes(destination.protocol)
            ? destination.href : 'https://news.ycombinator.com/item?id=' + story.id;
          a.target = '_blank';
          a.rel = 'noopener noreferrer';
          li.append(a);
          list.append(li);
        }
        updated.textContent = 'Updated ' + new Date().toLocaleTimeString();
      } catch {
        if (!list.children.length || list.textContent.includes('Fetching')) {
          const li = document.createElement('li');
          li.textContent = 'News temporarily unavailable.';
          list.replaceChildren(li);
        }
        updated.textContent = 'Could not refresh. Try again later.';
      } finally {
        refreshing = false;
      }
    }
    refresh();
    setInterval(refresh, 300000);
    document.addEventListener('visibilitychange', () => { if (!document.hidden) refresh(); });
  }
</script>
