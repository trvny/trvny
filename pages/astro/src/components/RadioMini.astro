<section class="panel radio" data-radio aria-labelledby="radio-heading">
  <div class="radio-head">
    <h2 id="radio-heading">Radio</h2>
    <span class="radio-live"><span aria-hidden="true"></span> LIVE</span>
  </div>
  <div class="radio-station"><span>RADIO PARADISE</span><span>MAIN MIX</span></div>
  <div class="radio-now">
    <div class="radio-art" aria-hidden="true">
      <span class="radio-fallback"><b>RP</b><small>RADIO<br />PARADISE</small></span>
      <img data-cover alt="" hidden />
    </div>
    <div class="radio-track">
      <span class="radio-kicker">ON AIR</span>
      <p class="radio-title" data-title>Radio Paradise</p>
      <p class="radio-artist" data-artist>Main mix · live stream</p>
      <p class="radio-album" data-album></p>
    </div>
  </div>
  <audio data-audio controls preload="none" src="https://stream.radioparadise.com/aac-320">
    <a href="https://streambench.travny.workers.dev/">Open Streambench</a>
  </audio>
  <div class="radio-controls" data-controls hidden>
    <button class="radio-play" data-play type="button" aria-label="Play Radio Paradise" aria-pressed="false">
      <svg class="play-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 4.5v15L19 12z" /></svg>
      <svg class="pause-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 5h4v14H6zm8 0h4v14h-4z" /></svg>
    </button>
    <div class="radio-control-main">
      <span class="radio-status" data-status role="status">Ready to play</span>
      <label class="radio-volume"><span>VOLUME</span><input data-volume aria-label="Radio volume" type="range" min="0" max="1" step="0.05" value="0.8" /></label>
    </div>
  </div>
  <div class="radio-footer"><span>320K AAC</span><a href="https://streambench.travny.workers.dev/">More stations ↗</a></div>
</section>

<style>
  .radio { border-top-color: var(--pink) !important; }
  .radio-head, .radio-station, .radio-footer { display:flex; align-items:center; justify-content:space-between; gap:12px; }
  .radio-head h2 { margin:0; }
  .radio-live, .radio-kicker, .radio-station, .radio-footer, .radio-volume { font-family:'Silkscreen',monospace; font-size:10px; letter-spacing:.04em; }
  .radio-live { color:var(--pink); white-space:nowrap; }
  .radio-live span { display:inline-block; width:7px; height:7px; background:currentColor; border-radius:50%; margin-right:5px; }
  .radio-station { color:var(--muted); padding:15px 0 11px; border-bottom:1px solid var(--line); }
  .radio-station span:first-child { color:var(--fg); }
  .radio-now { display:grid; grid-template-columns:112px minmax(0,1fr); gap:17px; align-items:center; padding:19px 0; }
  .radio-art { width:112px; aspect-ratio:1; position:relative; overflow:hidden; background:#2e1840; border:1px solid #62466d; }
  .radio-fallback { position:absolute; inset:0; display:flex; flex-direction:column; justify-content:center; align-items:center; color:var(--yellow); background:linear-gradient(145deg,#301746,#15283d); }
  .radio-fallback b { font:700 39px/1 'Silkscreen',monospace; }
  .radio-fallback small { font:9px/1.25 'Silkscreen',monospace; color:var(--fg); text-align:center; margin-top:6px; }
  .radio-art img { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; }
  .radio-art img[hidden], .radio-controls[hidden] { display:none; }
  .radio-track { min-width:0; overflow-wrap:anywhere; }
  .radio-kicker { color:var(--pink); }
  .radio .radio-title { color:var(--fg); font:700 22px/1.15 system-ui,sans-serif; margin:7px 0 5px; }
  .radio .radio-artist { color:var(--cyan); font:18px/1.2 system-ui,sans-serif; margin:0; }
  .radio .radio-album { color:var(--muted); font:17px/1.2 'VT323',monospace; margin:7px 0 0; }
  .radio-controls { display:flex; align-items:center; gap:14px; background:#111a25; padding:12px; }
  .radio-play { width:48px; height:48px; flex:none; display:grid; place-items:center; padding:0; background:var(--yellow); color:#090b10; border:0; border-radius:50%; }
  .radio-play:hover { background:#fff47a; }
  .radio-play svg { width:23px; height:23px; fill:currentColor; }
  .pause-icon, .radio[data-playing="true"] .play-icon { display:none; }
  .radio[data-playing="true"] .pause-icon { display:block; }
  .radio-control-main { flex:1; min-width:0; }
  .radio-status { display:block; color:var(--fg); font-size:19px; line-height:1.1; }
  .radio-volume { display:flex; align-items:center; gap:9px; color:var(--muted); margin-top:7px; }
  .radio-volume input { width:100%; min-width:0; height:18px; accent-color:var(--cyan); cursor:pointer; }
  .radio-footer { padding-top:15px; color:var(--muted); }
  .radio-footer a { color:var(--cyan); text-decoration:none; }
  .radio-footer a:hover { color:var(--yellow); text-decoration:underline; }
  @media (max-width:380px) { .radio-now { grid-template-columns:88px minmax(0,1fr); gap:12px; } .radio-art { width:88px; } .radio .radio-title { font-size:19px; } }
</style>

<script>
  document.querySelectorAll('[data-radio]').forEach((root) => {
    const audio = root.querySelector('[data-audio]');
    const controls = root.querySelector('[data-controls]');
    const play = root.querySelector('[data-play]');
    const volume = root.querySelector('[data-volume]');
    const status = root.querySelector('[data-status]');
    const cover = root.querySelector('[data-cover]');
    const title = root.querySelector('[data-title]');
    const artist = root.querySelector('[data-artist]');
    const album = root.querySelector('[data-album]');
    if (!(audio instanceof HTMLAudioElement) || !(controls instanceof HTMLElement) ||
        !(play instanceof HTMLButtonElement) || !(volume instanceof HTMLInputElement) ||
        !(status instanceof HTMLElement) || !(cover instanceof HTMLImageElement) ||
        !(title instanceof HTMLElement) || !(artist instanceof HTMLElement) || !(album instanceof HTMLElement)) return;

    const stream = audio.getAttribute('src');
    if (!stream) return;
    let wantsPlaying = false;
    let playbackAttempt = 0;
    let timer;
    let fetching = false;
    audio.volume = Number(volume.value);

    function showPlayback(playing, message) {
      root.dataset.playing = String(playing);
      play.setAttribute('aria-pressed', String(playing));
      play.setAttribute('aria-label', playing ? 'Pause Radio Paradise' : 'Play Radio Paradise');
      status.textContent = message;
    }
    function stop() {
      wantsPlaying = false;
      playbackAttempt += 1;
      audio.pause();
      audio.removeAttribute('src');
      audio.load();
      showPlayback(false, 'Paused');
    }
    async function start() {
      wantsPlaying = true;
      const attempt = ++playbackAttempt;
      audio.src = stream;
      showPlayback(true, 'Connecting…');
      try { await audio.play(); }
      catch { if (wantsPlaying && attempt === playbackAttempt) { wantsPlaying = false; showPlayback(false, 'Stream unavailable. Try again.'); } }
    }
    play.addEventListener('click', () => { if (wantsPlaying) stop(); else void start(); });
    volume.addEventListener('input', () => { audio.volume = Number(volume.value); });
    audio.addEventListener('play', () => {
      if (!wantsPlaying) { wantsPlaying = true; playbackAttempt += 1; showPlayback(true, 'Connecting…'); }
    });
    audio.addEventListener('pause', () => {
      if (audio.paused && wantsPlaying) { wantsPlaying = false; playbackAttempt += 1; showPlayback(false, 'Paused'); }
    });
    audio.addEventListener('playing', () => { if (wantsPlaying) showPlayback(true, 'Playing live'); });
    audio.addEventListener('waiting', () => { if (wantsPlaying) showPlayback(true, 'Buffering…'); });
    audio.addEventListener('error', () => { if (wantsPlaying) { wantsPlaying = false; showPlayback(false, 'Stream unavailable. Try again.'); } });
    cover.addEventListener('error', () => { cover.hidden = true; cover.removeAttribute('src'); });
    audio.hidden = true;
    controls.hidden = false;

    async function refresh() {
      if (document.hidden || fetching) return;
      fetching = true;
      try {
        const response = await fetch('/api/radio-now', { cache:'no-store', signal:AbortSignal.timeout(8000) });
        if (!response.ok) throw new Error('metadata unavailable');
        const track = await response.json();
        title.textContent = track.title;
        artist.textContent = track.artist;
        album.textContent = track.album || '';
        if (track.cover) { cover.src = track.cover; cover.hidden = false; }
        else { cover.hidden = true; cover.removeAttribute('src'); }
      } catch {
        title.textContent = 'Radio Paradise';
        artist.textContent = 'Track details unavailable';
        album.textContent = '';
        cover.hidden = true;
        cover.removeAttribute('src');
      } finally {
        fetching = false;
        clearTimeout(timer);
        if (!document.hidden) timer = setTimeout(refresh, 30000);
      }
    }
    document.addEventListener('visibilitychange', () => {
      clearTimeout(timer);
      if (!document.hidden) void refresh();
    });
    artist.textContent = 'Loading track details…';
    void refresh();
  });
</script>
