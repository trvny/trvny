---
const { title, description, article = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, 'https://travny.pages.dev');
---
<!doctype html>
<html lang="pl">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <meta name="robots" content="index,follow" />
  <link rel="canonical" href={canonical} />
  <meta property="og:type" content={article ? 'article' : 'website'} />
  <meta property="og:title" content={`${title} · TRAVNY`} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Silkscreen:wght@400;700&family=VT323&display=swap" rel="stylesheet" />
  <title>{title} · TRAVNY</title>
</head>
<body>
  <main class="shell">
    <nav class="crumb" aria-label="Breadcrumb"><a href="/">TRAVNY</a> / <a href="/przeglad/">CoCzyDziennik</a></nav>
    <slot />
  </main>
</body>
</html>
<style is:global>
:root{color-scheme:dark;--bg:#070a10;--panel:#0b0f16;--text:#e6e8ea;--muted:#aab1bb;--cyan:#46e0e0;--yellow:#f5e94e;--pink:#e85ad0}
*{box-sizing:border-box}html{background:#000}body{margin:0;background:var(--bg);color:var(--text);font:22px/1.35 'VT323',monospace;padding:clamp(20px,4vw,54px)}
a{color:var(--cyan)}a:focus-visible{outline:3px solid var(--yellow);outline-offset:4px}.shell{width:min(1200px,100%);margin:auto}.crumb{color:var(--muted);margin-bottom:36px}.crumb a{text-decoration:none}
h1,h2,h3{font-family:'Silkscreen',monospace;line-height:1.15}h1{color:var(--yellow);font-size:clamp(30px,5vw,56px);overflow-wrap:anywhere}h2{font-size:clamp(21px,3vw,28px);color:var(--cyan)}.lede{max-width:65ch;color:var(--muted);font-size:26px}.rule{height:6px;margin:30px 0;background:linear-gradient(90deg,var(--cyan) 0 34%,var(--yellow) 34% 67%,var(--pink) 67%)}
.archive{display:grid;grid-template-columns:minmax(0,2fr) minmax(220px,1fr);gap:36px}.issue{display:block;background:var(--panel);border-top:5px solid var(--cyan);padding:20px;margin-bottom:14px;text-decoration:none;color:var(--text)}.issue:hover{background:#111826}.issue h2{margin:8px 0}.issue p{margin:0;color:var(--muted)}.date{color:var(--pink)}.sidebar{border-top:5px solid var(--pink);padding-top:12px}.sidebar h2{font-size:18px;color:var(--pink)}.sidebar p{color:var(--muted)}.article{max-width:780px}.article h2{margin-top:48px}.article p,.article li{font-size:25px;line-height:1.45}.article a{overflow-wrap:anywhere}.article img{max-width:100%;height:auto}.article blockquote{border-left:4px solid var(--pink);padding-left:20px;margin-left:0;color:var(--muted)}
@media(max-width:720px){body{padding:20px 16px}.archive{grid-template-columns:1fr;gap:20px}.crumb{margin-bottom:28px}.article p,.article li{font-size:22px}}
</style>
