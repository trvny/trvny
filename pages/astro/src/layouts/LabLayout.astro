---
import '../styles/lab.css';
const { title = 'Laboratory', description = 'Experiments from the TRAVNY workshop.' } = Astro.props.frontmatter ?? Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, 'https://travny.pages.dev').toString();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} · TRAVNY Lab`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <title>{title} · TRAVNY Lab</title>
  </head>
  <body>
    <main class="shell">
      <nav class="crumb"><a href="/">TRAVNY</a> / <a href="/lab/">LAB</a></nav>
      <slot />
    </main>
  </body>
</html>
