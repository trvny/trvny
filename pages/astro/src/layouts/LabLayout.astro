---
import '../styles/lab.css';
import { breadcrumbJson } from '../lib/breadcrumbs.mjs';
const { title = 'Laboratory', description = 'Experiments from the TRAVNY workshop.' } = Astro.props.frontmatter ?? Astro.props;
const canonicalPath = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonicalUrl = new URL(canonicalPath, 'https://travny.pages.dev').toString();
const isLabHome = canonicalPath === '/lab/';
const crumbs = [
  { name: 'TRAVNY', item: 'https://travny.pages.dev/' },
  { name: 'LAB', item: 'https://travny.pages.dev/lab/' },
  ...(!isLabHome ? [{ name: title, item: canonicalUrl }] : []),
];
const breadcrumbs = breadcrumbJson(crumbs);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} · TRAVNY Lab`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <title>{title} · TRAVNY Lab</title>
    <script type="application/ld+json" set:html={breadcrumbs} />
  </head>
  <body>
    <main class="shell">
      <nav class="crumb" aria-label="Breadcrumb">{crumbs.map((crumb, index) => <>{index > 0 && ' / '}{index === crumbs.length - 1 ? <span aria-current="page">{crumb.name}</span> : <a href={new URL(crumb.item).pathname}>{crumb.name}</a>}</>)}</nav>
      <slot />
    </main>
  </body>
</html>
