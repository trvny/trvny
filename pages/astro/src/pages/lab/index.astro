---
import LabLayout from '../../layouts/LabLayout.astro';
import NewsTicker from '../../components/NewsTicker.astro';
import BenchLab from '../../components/BenchLab.astro';
---
<LabLayout title="The workshop" description="Experiments, live news and small browser tools from TRAVNY: benchmarks, interactive remakes and field notes worth a click.">
  <h1>The workshop</h1>
  <p class="lede">Live news, browser workbenches and experiments from the TRAVNY workshop.</p>
  <BenchLab />
  <div class="grid">
    <NewsTicker />
    <section class="panel">
      <h2>Field notes</h2>
      <p>Ideas and experiments from the workshop.</p>
      <a href="/lab/field-notes/">Read the notes ↗</a>
    </section>
    <section class="panel">
      <h2>Token Worldcup</h2>
      <p>Compare how languages stack up in the token arena.</p>
      <a href="/teksty/token-worldcup/">Open Token Worldcup ↗</a> ·
      <a href="https://token-worldcup.travny.chatgpt.site/">Interactive remake ↗</a>
    </section>
    <section class="panel">
      <h2>Badges</h2>
      <p>Ecosystem, bot and AI badges plus live counters and status, ready to paste as Markdown or HTML.</p>
      <a href="/badges/">Open the catalogue ↗</a>
    </section>
  </div>
</LabLayout>
