---
import LabLayout from '../../layouts/LabLayout.astro';
import NewsTicker from '../../components/NewsTicker.astro';
import RadioMini from '../../components/RadioMini.astro';
---
<LabLayout title="The workshop" description="Experiments, live news and small tools from TRAVNY.">
  <p class="meta">TRAVNY / LAB</p>
  <h1>The workshop</h1>
  <p class="lede">Live news, radio and experiments from the TRAVNY workshop.</p>
  <div class="grid">
    <NewsTicker />
    <RadioMini />
    <section class="panel">
      <h2>Field notes</h2>
      <p>Ideas and experiments from the workshop.</p>
      <a href="/lab/field-notes/">Read the notes ↗</a>
    </section>
    <section class="panel">
      <h2>Token Worldcup</h2>
      <p>Compare how languages stack up in the token arena.</p>
      <a href="/teksty/token-worldcup/">Open Token Worldcup ↗</a>
    </section>
  </div>
</LabLayout>
