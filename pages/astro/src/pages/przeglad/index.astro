---
import { getCollection, render } from 'astro:content';
import DigestLayout from '../../layouts/DigestLayout.astro';
import DigestArchive from '../../components/DigestArchive.svelte';
import { digestTopics } from '../../lib/digest-topics.mjs';
const issues = (await getCollection('digests', ({ data }) => !data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const formatDate = new Intl.DateTimeFormat('pl-PL', { dateStyle: 'long', timeZone: 'UTC' });
const archive = await Promise.all(issues.map(async issue => {
  const { id, data } = issue;
  const { headings } = await render(issue);
  return {
    id,
    date: formatDate.format(data.date),
    title: data.title,
    summary: data.description,
    topics: digestTopics(headings, data.magazine?.sections),
  };
}));
---
<DigestLayout title="CoCzyDziennik" description="Przegląd wydarzeń, technologii i kultury — archiwum CoCzyDziennika TRAVNY: wydania, streszczenia i linki do źródeł.">
  <h1>CoCzyDziennik</h1>
  <p class="lede">Świat, technologia, kultura i ciekawostki. Przegląd w jednym miejscu, z linkami do źródeł.</p>
  <div class="rule"></div>
  <div class="archive">
    <section aria-labelledby="issues-heading">
      <h2 id="issues-heading">Wydania</h2>
      <DigestArchive client:idle issues={archive} />
    </section>
    <aside class="sidebar"><h2>O przeglądzie</h2><p>Publiczna wersja przeglądu przygotowywanego co trzy dni. Każde wydanie zostaje w archiwum.</p><a href="/teksty/">Pozostałe teksty TRAVNY</a></aside>
  </div>
</DigestLayout>
