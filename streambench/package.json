{
  "name": "streambench",
  "private": true,
  "version": "0.9.0",
  "description": "Browser-based IPTV, radio and stream tester.",
  "scripts": {
    "build": "node scripts/vendor.mjs && node scripts/portable.mjs",
    "check": "npm run build && npm run check:syntax && npm test && npx wrangler deploy --dry-run",
    "check:syntax": "node scripts/syntax-check.mjs",
    "dev": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "smoke": "node scripts/smoke.mjs",
    "test": "node --test \"scripts/*-check.mjs\""
  },
  "dependencies": {
    "hls.js": "1.6.17"
  },
  "devDependencies": {
    "wrangler": "^4"
  }
}
