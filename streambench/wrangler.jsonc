{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "streambench",
  "main": "src/entry.js",
  "compatibility_date": "2026-07-26",
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.01,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.01,
      "invocation_logs": true
    }
  }
}
