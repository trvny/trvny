{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shitpost-reactor",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "shitpost.trfny.com",
      "custom_domain": true
    }
  ],
  "r2_buckets": [
    {
      "binding": "FEED",
      "bucket_name": "shitpost-reactor"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.01,
      "persist": true,
      "invocation_logs": false
    },
    "traces": {
      "enabled": false
    }
  }
}
