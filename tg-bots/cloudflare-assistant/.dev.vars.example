# Local-only values. Copy to .dev.vars; never commit that file.
TELEGRAM_BOT_TOKEN=1234567890:replace-me
TELEGRAM_WEBHOOK_SECRET=replace-with-a-long-random-string
INGEST_SECRET=replace-with-a-long-random-string
OWNER_TELEGRAM_USER_ID=123456789
TELEGRAM_OWNER_CHAT_ID=123456789

# Leave empty unless Telegram Business recipients are configured to Contacts only.
# Set to contacts-only to enable the 12h Secretary idle auto-reply.
SECRETARY_AUTO_REPLY_SCOPE=

# Required for model-backed local flows while Workers AI is reserved for SpaceMolt.
# Production can copy the existing repo secret through automation-sync.yml.
KANAREK_REVIEW_ROUTER_TOKEN=
