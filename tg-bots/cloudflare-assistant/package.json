{
  "name": "travny-tg-assistant",
  "version": "0.1.0",
  "private": true,
  "description": "Cloudflare Telegram assistant automatically deployed through Workers Builds.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "check": "tsc --noEmit",
    "test": "node --experimental-transform-types --test test/*.test.mjs",
    "queue:create": "wrangler queues create travny-tg-assistant-updates && wrangler queues create travny-tg-assistant-updates-dlq",
    "telegram:updates": "node scripts/telegram-webhook.mjs updates",
    "telegram:profile": "node scripts/telegram-profile.mjs",
    "webhook:set": "node scripts/telegram-webhook.mjs set",
    "webhook:info": "node scripts/telegram-webhook.mjs info",
    "webhook:delete": "node scripts/telegram-webhook.mjs delete"
  },
  "devDependencies": {
    "@grammyjs/types": "5.0.0",
    "typescript": "7.0.2",
    "wrangler": "4.136.2"
  }
}
