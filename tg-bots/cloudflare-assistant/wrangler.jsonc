{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "travny-tg-assistant",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-06",
  "ai": {
    "binding": "AI"
  },
  "queues": {
    "producers": [
      {
        "binding": "TELEGRAM_UPDATES",
        "queue": "travny-tg-assistant-updates"
      }
    ],
    "consumers": [
      {
        "queue": "travny-tg-assistant-updates",
        "max_batch_size": 5,
        "max_batch_timeout": 1,
        "max_retries": 5
      }
    ]
  },
  "vars": {
    "ORCAROUTER_MODEL": "orcarouter/free",
    "OLLAMA_MODEL": "glm-5.3",
    "OPENROUTER_MODEL": "openrouter/free",
    "WORKERS_AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "RSS_MIN_SCORE": "75"
  }
}
