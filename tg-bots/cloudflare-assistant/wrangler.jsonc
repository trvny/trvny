{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "travny-tg-assistant",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-06",
  "ai": {
    "binding": "AI"
  },
  "services": [
    {
      "binding": "KANAREK_COMPANION",
      "service": "kanarek-companion",
      "remote": true
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "TELEGRAM_UPDATES",
        "queue": "travny-tg-assistant-updates"
      },
      {
        "binding": "TELEGRAM_DLQ",
        "queue": "travny-tg-assistant-updates-dlq"
      }
    ],
    "consumers": [
      {
        "queue": "travny-tg-assistant-updates",
        "max_batch_size": 5,
        "max_batch_timeout": 1,
        "max_retries": 5,
        "retry_delay": 5,
        "max_concurrency": 1,
        "dead_letter_queue": "travny-tg-assistant-updates-dlq"
      }
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "TELEGRAM_DEDUP",
        "class_name": "TelegramUpdateDedup"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["TelegramUpdateDedup"]
    }
  ],
  "vars": {
    "WORKERS_AI_MODEL": "@cf/zai-org/glm-4.7-flash",
    "RSS_MIN_SCORE": "75"
  }
}
